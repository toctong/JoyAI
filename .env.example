# Database (SQLite via TypeORM sql.js — path relative to apps/server cwd)
DATABASE_PATH=./data/sql.db

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=admin123

# Server
PORT=3001
# Production allowlist (comma-separated). Dev ignores this and reflects request Origin
# so teammates can open http://<your-lan-ip>:3000 without CORS edits.
CORS_ORIGINS=http://localhost:3000,http://192.168.1.56:3000

# Explore feed proxy (Elser community)
ELSER_FEED_BASE_URL=https://api.tool.elser.ai/v1
# 探索 feed 硬缓存 TTL（毫秒）：Elser + 各社区源共用；配合定时预热默认 6 小时；设为 0 关闭缓存
ELSER_FEED_CACHE_TTL_MS=21600000
# 软过期（毫秒）：过后仍立刻返回缓存，并后台 stale-while-revalidate；默认 2 小时
# ELSER_FEED_SOFT_TTL_MS=7200000
# 后台预热间隔（毫秒）：启动后拉取各社区首屏写入缓存；默认 3 小时；设为 0 关闭
EXPLORE_FEED_WARM_MS=10800000
# 每个源预热页数（按 cursor 链式拉，默认 3，最大 5）
EXPLORE_FEED_WARM_PAGES=3
# 进程启动后首次预热延迟（毫秒），默认 8 秒
# EXPLORE_FEED_WARM_BOOT_MS=8000
# Elser / PixAI / Civitai 出站代理回退（优先后台「设置 → 探索」explore.marketProxy）
# EXPLORE_MARKET_PROXY=http://127.0.0.1:7890

# Volcengine Ark
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-4-0-250828
ARK_VIDEO_MODEL=doubao-seedance-2-0-260128

# APIMart (OpenAI-compatible)
APIMART_API_KEY=
APIMART_BASE_URL=https://apib.ai/v1

# ToAPIs (OpenAI-compatible)
TOAPIS_API_KEY=
TOAPIS_BASE_URL=https://toapis.cn/v1

# Aliyun DashScope / Bailian (OpenAI-compatible + HappyHorse native video)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://llm-oxwm46w4kzmd5vir.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# Job workers / timeouts
# Parallel image jobs per server process (default 5, max 20)
JOB_IMAGE_CONCURRENCY=5
# Video poll can run 20–40m; keep headroom before wall-clock auto-fail
JOB_VIDEO_TIMEOUT_MS=3000000
# Image generate + in-process poll (~8m) + queue slack
JOB_IMAGE_TIMEOUT_MS=900000
# Stuck queued (worker / Redis down)
JOB_QUEUED_TIMEOUT_MS=1200000
# How often to scan stale jobs
JOB_TIMEOUT_SWEEP_MS=60000

# Volcengine TOS
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_REGION=cn-beijing
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_BUCKET=
TOS_PUBLIC_BASE_URL=
# Unreferenced by-hash GC (default: scan/log only; set DELETE=true to purge)
STORAGE_GC_ENABLED=true
STORAGE_GC_DELETE=false
# How often to scan (default 6h)
STORAGE_GC_SWEEP_MS=21600000
# Only consider objects older than this (default 7d)
STORAGE_GC_MIN_AGE_MS=604800000

# Settings encryption (optional)
SETTINGS_SECRET=
