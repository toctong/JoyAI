# Database (SQLite — file relative to apps/server/prisma/)
DATABASE_URL="file:./sql.db"

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=admin123

# Server
PORT=3001
CORS_ORIGINS=http://localhost:3000

# Volcengine Ark
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-4-0-250828
ARK_VIDEO_MODEL=doubao-seedance-1-0-pro-250528

# APIMart (OpenAI-compatible)
APIMART_API_KEY=
APIMART_BASE_URL=https://api.apimart.ai/v1

# ToAPIs (OpenAI-compatible)
TOAPIS_API_KEY=
TOAPIS_BASE_URL=https://toapis.cn/v1

# Aliyun DashScope / Bailian (OpenAI-compatible + HappyHorse native video)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Volcengine TOS
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_REGION=cn-beijing
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_BUCKET=
TOS_PUBLIC_BASE_URL=

# Settings encryption (optional)
SETTINGS_SECRET=
