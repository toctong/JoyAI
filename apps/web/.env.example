# next
# Local: hit Nest directly. On LAN IP / domain, the client switches to same-origin
# /api (Next rewrites → Nest) so HTTPS reverse proxies work without opening :18081.
# Docker image bakes NEXT_PUBLIC_API_URL=/api.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_WS_URL=http://localhost:3001
