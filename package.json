{
  "name": "joyai",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:packages": "pnpm --filter @joyai/shared build && pnpm --filter @joyai/ai-providers build",
    "dev": "pnpm build:packages && pnpm -r --parallel --filter @joyai/server --filter @joyai/web run dev",
    "dev:server": "pnpm build:packages && pnpm --filter @joyai/server dev",
    "dev:web": "pnpm build:packages && pnpm --filter @joyai/web dev",
    "build": "pnpm build:packages && pnpm -r --filter @joyai/server --filter @joyai/web run build",
    "lint": "pnpm -r run lint",
    "db:generate": "pnpm --filter @joyai/server prisma:generate",
    "db:migrate": "pnpm --filter @joyai/server prisma:migrate",
    "db:push": "pnpm --filter @joyai/server prisma:push"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
